# --- app ---
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8400
DASHBOARD_PORT=3400
# --- db / queue ---
DATABASE_URL=postgresql+psycopg://tt:tt@postgres:5432/tt
REDIS_URL=redis://redis:6379/0
# --- TikTok Shop (Partner Center app) ---
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_REFRESH_TOKEN=
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_SHOP_CIPHER=
TIKTOK_SHOP_REGION=ID
# --- TikTok Ads / Marketing API ---
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=
# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# --- shop config ---
SHOP_TIMEZONE=Asia/Jakarta
SHOP_CURRENCY=IDR
